{
  "name": "loopwright",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "26.x",
    "npm": "11.x"
  },
  "workspaces": [
    "packages/core",
    "packages/state"
  ],
  "scripts": {
    "build": "npm run build:core && tsc -p packages/state/tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-build/packages/core/test/*.test.js .test-build/packages/state/test/*.test.js",
    "build:core": "tsc -p packages/core/tsconfig.json",
    "pretypecheck": "npm run build:core",
    "pretest": "npm run build:core"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
