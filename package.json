{
  "name": "loopwright",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "26.x",
    "npm": "11.x"
  },
  "workspaces": [
    "packages/core",
    "packages/state",
    "packages/agent-pi",
    "packages/controller",
    "packages/cli",
    "packages/taskpack-runner",
    "packages/github-app",
    "packages/memory",
    "packages/decisions"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint:docs": "node scripts/check-docs.mjs",
    "pack:npm": "node scripts/pack-npm.mjs",
    "site": "node scripts/site.mjs build",
    "site:serve": "node scripts/site.mjs serve",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "build:core": "tsc -p packages/core/tsconfig.json",
    "pretypecheck": "node -e \"const fs=require('node:fs');if(!fs.existsSync('packages/core/dist/index.js'))require('node:child_process').execSync('npm run build:core',{stdio:'inherit'})\"",
    "pretest": "node -e \"const fs=require('node:fs');if(!fs.existsSync('packages/core/dist/index.js'))require('node:child_process').execSync('npm run build:core',{stdio:'inherit'})\"",
    "qualify:pi": "node packages/agent-pi/qualification/run.mjs",
    "qualify:controller": "node packages/controller/qualification/run.mjs",
    "test:pi": "node packages/agent-pi/qualification/test-runner.mjs",
    "test:controller": "node packages/controller/qualification/test-runner.mjs",
    "qualify:pi:live": "node packages/agent-pi/qualification/live.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
