{
  "name": "loopwright",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "26.x",
    "npm": "11.x"
  },
  "workspaces": [
    "packages/core",
    "packages/state",
    "packages/agent-pi",
    "packages/controller",
    "packages/cli",
    "packages/taskpack-runner",
    "packages/github-app",
    "packages/memory"
  ],
  "scripts": {
    "build": "npm run build:core && tsc -p packages/state/tsconfig.json && tsc -p packages/agent-pi/tsconfig.json && tsc -p packages/controller/tsconfig.json && tsc -p packages/cli/tsconfig.json && tsc -p packages/taskpack-runner/tsconfig.json && tsc -p packages/memory/tsconfig.json && tsc -p packages/github-app/tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-build/packages/core/test/*.test.js .test-build/packages/state/test/*.test.js .test-build/packages/agent-pi/test/*.test.js .test-build/packages/controller/test/*.test.js .test-build/packages/cli/test/*.test.js .test-build/packages/taskpack-runner/test/*.test.js .test-build/packages/memory/test/*.test.js .test-build/packages/github-app/test/*.test.js packages/agent-pi/qualification/absence.test.mjs packages/agent-pi/qualification/docker-socket.test.mjs packages/controller/qualification/schedule.test.mjs",
    "build:core": "tsc -p packages/core/tsconfig.json",
    "pretypecheck": "npm run build:core",
    "pretest": "npm run build:core",
    "qualify:pi": "node packages/agent-pi/qualification/run.mjs",
    "qualify:controller": "node packages/controller/qualification/run.mjs",
    "test:pi": "node packages/agent-pi/qualification/test-runner.mjs",
    "test:controller": "node packages/controller/qualification/test-runner.mjs",
    "qualify:pi:live": "node packages/agent-pi/qualification/live.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
